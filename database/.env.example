# Private Postgres instance for this project (see db.js). Shares nothing with other servers.
PG_PORT=5434
PG_USER=taskdash
PG_PASSWORD=taskdash
# Optional: folder containing pg_ctl / initdb / psql if auto-detection fails
# PG_BIN=/usr/local/opt/postgresql@18/bin

# Databases migrated by migrate.js (one per backend service)
AUTH_DATABASE_URL=postgres://taskdash:taskdash@localhost:5434/taskdash_auth
API_DATABASE_URL=postgres://taskdash:taskdash@localhost:5434/taskdash_api
CRM_DATABASE_URL=postgres://taskdash:taskdash@localhost:5434/taskdash_crm
HELPDESK_DATABASE_URL=postgres://taskdash:taskdash@localhost:5434/taskdash_helpdesk

# Password given to every seeded demo account
SEED_PASSWORD=Password123!

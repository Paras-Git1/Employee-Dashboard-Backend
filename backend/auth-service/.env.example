PORT=4003
NODE_ENV=development
DATABASE_URL=postgres://taskdash:taskdash@localhost:5434/taskdash_auth
# Must be identical to JWT_SECRET in services/api/.env (scripts/setup-env.js generates one)
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
SESSION_COOKIE=td_session
# Failed logins allowed per email+IP inside the window before returning 429
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Frontend origins allowed to call this service with cookies (comma-separated)
CORS_ORIGIN=http://localhost:5173
# Cookie settings. Locally (all on localhost) lax is right. When the frontend and
# backend are on different sites in production, use COOKIE_SAMESITE=none (requires HTTPS),
# and COOKIE_DOMAIN if the API lives on a sibling subdomain of the auth service.
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

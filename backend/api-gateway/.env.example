PORT=3001
NODE_ENV=development
DATABASE_URL=postgres://taskdash:taskdash@localhost:5434/taskdash_api
# Must be identical to JWT_SECRET in services/auth/.env
JWT_SECRET=change-me
SESSION_COOKIE=td_session

# Where the API calls the source systems
CRM_BASE_URL=http://localhost:4001
HELPDESK_BASE_URL=http://localhost:4002
# Where the browser opens task links (defaults to the base URLs above)
CRM_PUBLIC_URL=http://localhost:4001
HELPDESK_PUBLIC_URL=http://localhost:4002

SOURCE_TIMEOUT_MS=3000
CACHE_TTL_SECONDS=45

# Frontend origins allowed to call this service with cookies (comma-separated)
CORS_ORIGIN=http://localhost:5173
